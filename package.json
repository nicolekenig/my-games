{
  "name": "my-games",
  "version": "1.0.0",
  "description": "Local multiplayer & single-player games — plain HTML + CSS + JS, dark mode, mobile-friendly",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "pretest:e2e": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "jest": "^29.7.0",
    "socket.io-client": "^4.7.5"
  },
  "jest": {
    "testTimeout": 10000,
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/",
      "/tests/e2e/"
    ]
  }
}
